{
  "editor.fontFamily": "PragmataPro Mono Liga",
  "editor.fontLigatures": true,
  "vim.useCtrlKeys": true,
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": false,
    "<C-f>": false,
    "<C-z>": false,
    "<C-p>": false
  },
  "vim.leader": "<space>",
  "vim.normalModeKeyBindings": [
    {
      "before": ["<leader>", "r"],
      "commands": ["editor.action.rename"]
    },
    {
      "before": ["<leader>", "p"],
      "commands": ["editor.action.quickFix"]
    }
  ],
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 500,
  "vim.highlightedyank.color": "rgba(255, 255, 255, 0.2)",
  "editor.formatOnSave": true,
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.quickSuggestions": {
      "strings": true
    },
    "editor.suggest.insertMode": "replace",
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": [
      "source.formatDocument",
      "source.fixAll.eslint"
    ]
  },
  "[typescriptreact]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": [
      "source.formatDocument",
      "source.fixAll.eslint"
    ]
  },
  "[javascript]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": [
      "source.formatDocument",
      "source.fixAll.eslint"
    ]
  },
  "[javascriptreact]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": [
      "source.formatDocument",
      "source.fixAll.eslint"
    ]
  },
  "workbench.iconTheme": "catppuccin-mocha",
  "gitlens.views.scm.grouped.hiddenViews": {
    "commits": false,
    "worktrees": false,
    "branches": false,
    "remotes": false,
    "stashes": true,
    "tags": false,
    "contributors": false,
    "repositories": true,
    "fileHistory": false,
    "launchpad": false,
    "searchAndCompare": false
  },
  "gitlens.views.commits.showStashes": true,
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": false,
    "remotes": true,
    "stashes": false,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "fileHistory": false,
    "repositories": true,
    "searchAndCompare": false,
    "launchpad": false
  },

  "editor.mouseWheelZoom": true,
  "editor.bracketPairColorization.enabled": false,
  "editor.tabSize": 2,
  "debug.javascript.autoAttachFilter": "disabled",
  "editor.semanticHighlighting.enabled": true,
  "editor.rulers": [120],
  "remote.autoForwardPortsSource": "hybrid",
  "chat.viewSessions.orientation": "stacked",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "chat.disableAIFeatures": true,
  "workbench.colorTheme": "Vague",
  "[markdown]": {
    "editor.defaultFormatter": "ms-vsliveshare.vsliveshare"
  },
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nil",
  "nix.serverSettings": {
    "nil": {
      "formatting": {
        "command": ["nixfmt"]
      },
      "flake": {
        "autoArchive": true,
        "autoEvalInputs": true
      }
    }
  }
}

